<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1426</width>
    <height>826</height>
   </rect>
  </property>
  <property name="minimumSize">
   <size>
    <width>800</width>
    <height>650</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>MICRO-Software</string>
  </property>
  <property name="windowIcon">
   <iconset resource="resources.qrc">
    <normaloff>:/resources/icons/app_icon.png</normaloff>:/resources/icons/app_icon.png</iconset>
  </property>
  <property name="styleSheet">
   <string notr="true">
QMainWindow, QDialog, QWidget#centralwidget, QWidget#MAIN, QWidget#GRAF, QWidget#TELE, QStackedWidget {
    background-color: #1e1e2d;
    color: #e2e2e2;
}

QPushButton {
    background-color: #27293d;
    color: #00f2c3;
    border: 1px solid #e14eca;
    border-radius: 6px;
    padding: 6px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #e14eca;
    color: white;
}

QLineEdit, QTextBrowser, QComboBox {
    background-color: #1d1e2b;
    color: #00f2c3;
    border: 1px solid #27293d;
    border-radius: 4px;
    padding: 3px;
}

QSpinBox, QDoubleSpinBox {
    background-color: #1d1e2b;
    color: #00f2c3;
    border: 1px solid #27293d;
    border-radius: 4px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 4px;
    padding-right: 22px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #00f2c3;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    background-color: #27293d;
    border-left: 1px solid #1d1e2b;
    border-bottom: 1px solid #1d1e2b;
    border-top-right-radius: 4px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background-color: #e14eca;
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed {
    background-color: #00f2c3;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/resources/icons/arrow_up.png);
    width: 9px;
    height: 9px;
    subcontrol-origin: margin;
    subcontrol-position: center;
}

QSpinBox::up-arrow:hover, QDoubleSpinBox::up-arrow:hover {
    image: url(:/resources/icons/arrow_up_hover.png);
}

QSpinBox::up-arrow:pressed, QDoubleSpinBox::up-arrow:pressed {
    image: url(:/resources/icons/arrow_up_pressed.png);
}

QSpinBox::up-arrow:disabled, QSpinBox::up-arrow:off,
QDoubleSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:off {
    image: url(:/resources/icons/arrow_up_disabled.png);
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    background-color: #27293d;
    border-left: 1px solid #1d1e2b;
    border-bottom-right-radius: 4px;
}

QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #e14eca;
}

QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: #00f2c3;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/resources/icons/arrow_down.png);
    width: 9px;
    height: 9px;
    subcontrol-origin: margin;
    subcontrol-position: center;
}

QSpinBox::down-arrow:hover, QDoubleSpinBox::down-arrow:hover {
    image: url(:/resources/icons/arrow_down_hover.png);
}

QSpinBox::down-arrow:pressed, QDoubleSpinBox::down-arrow:pressed {
    image: url(:/resources/icons/arrow_down_pressed.png);
}

QSpinBox::down-arrow:disabled, QSpinBox::down-arrow:off,
QDoubleSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:off {
    image: url(:/resources/icons/arrow_down_disabled.png);
}

QLabel {
    color: #e2e2e2;
    font-weight: bold;
    border: none;
    background: transparent;
}

QGroupBox {
    border: 1px solid #27293d;
    margin-top: 10px;
    color: #e14eca;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 3px;
}

QLCDNumber {
    color: #00f2c3;
    background-color: #1d1e2b;
    border: 1px solid #27293d;
}

QCheckBox {
    color: #e2e2e2;
}
/* Boxes para Telemetria y Sensores/Modo Esquivado en Main, 3D, Graficas y Comandos */
QFrame#box_linea, QFrame#box_balance, QFrame#box_motores, QFrame#box_dodge_bias, QFrame#box_esquivar, QFrame#box_sensors, QFrame#box_3d_container, QFrame#box_chart_orientation, QFrame#box_chart_balance, QFrame#box_chart_line, QFrame#box_manual_commands {
    background-color: #151522;
    border-top: 1px solid #2d2f44;
    border-left: 1px solid #2d2f44;
    border-bottom: 1px solid #0e0e16;
    border-right: 1px solid #0e0e16;
    border-radius: 8px;
}

/* Bisel estandar para el contenedor del viewport 3D */
QFrame#frame_3d_viewport {
    background-color: #101018;
    border-top: 1px solid #232536;
    border-left: 1px solid #232536;
    border-bottom: 1px solid #090910;
    border-right: 1px solid #090910;
    border-radius: 6px;
}

/* Cajas individuales para cada item modificador */
QFrame#item_line_kp, QFrame#item_line_kd, QFrame#item_attack_sp, QFrame#item_custom_turn,
QFrame#item_kp_cascada, QFrame#item_ki_cascada, QFrame#item_filter_lpf,
QFrame#item_bal_kp, QFrame#item_bal_kd, QFrame#item_bal_ki, QFrame#item_bal_sp,
QFrame#item_vel_div, QFrame#item_vel_lim, QFrame#item_turn_lim,
QFrame#item_pwm_min_l, QFrame#item_pwm_min_r, QFrame#item_pwm_l, QFrame#item_pwm_r,
QFrame#item_off_l, QFrame#item_off_r, QFrame#item_pwm_lrot, QFrame#item_pwm_rrot,
QFrame#item_static_off, QFrame#item_moving_off, QFrame#item_limit_angle,
QFrame#item_front_dist, QFrame#item_side_dist, QFrame#item_lost_dist, QFrame#item_stop_cycles,
QFrame#item_align_dist, QFrame#item_corner_dist, QFrame#item_wall_kp, QFrame#item_wall_kd,
QFrame#item_front_kp, QFrame#item_front_kd, QFrame#item_dodgeDir {
    background-color: #101018;
    border-top: 1px solid #222334;
    border-left: 1px solid #222334;
    border-bottom: 1px solid #090910;
    border-right: 1px solid #090910;
    border-radius: 6px;
}

/* Titulos destacados de las secciones */
QLabel#label_sensors_10, QLabel#label_sensors_9, QLabel#label_sensors_3, QLabel#label_title_dodge_bias, QLabel#label_sensors_4 {
    color: #00f2c3;
    font-size: 11pt;
    font-weight: bold;
    padding-bottom: 2px;
}

QLabel#label_dodgeDir {
    color: #00f2c3;
    font-size: 8pt;
    font-weight: bold;
}

/* Titulo de sensores compacto (Poco lugar como pidio el usuario) */
QLabel#label_sensors {
    color: #e14eca;
    font-size: 8.5pt;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 0px;
    margin: 0px;
    max-height: 16px;
}

/* Indicador FRENTE DEL AUTO */
QLabel#label_car_front {
    color: #00f2c3;
    font-size: 8pt;
    font-weight: bold;
    letter-spacing: 1.5px;
    padding: 1px 0px;
}

/* Cuadraditos de posicion de sensores en el autito (Obstaculos) */
QLabel#sens_pos_front, QLabel#sens_pos_ir5, QLabel#sens_pos_ir8,
QLabel#sens_pos_ir3, QLabel#sens_pos_ir1 {
    background-color: #1a1a2a;
    border: 1.5px solid #e14eca;
    border-radius: 4px;
    color: #ffffff;
    font-size: 6.5pt;
    font-weight: bold;
    padding: 1px;
}

/* Cuadraditos de posicion de sensores en el autito (Linea) */
QLabel#sens_pos_line_l, QLabel#sens_pos_line_c, QLabel#sens_pos_line_r {
    background-color: #121a22;
    border: 1.5px solid #00f2c3;
    border-radius: 4px;
    color: #00f2c3;
    font-size: 6.5pt;
    font-weight: bold;
    padding: 1px;
}

/* Chasis del autito */
QFrame#frame_car_diagram {
    background-color: #101018;
    border: 1px solid #232536;
    border-radius: 6px;
}

QFrame#frame_chassis {
    background-color: #151624;
    border: 1.5px dashed #3a3d54;
    border-radius: 6px;
}

QLabel#label_chassis_title {
    color: #00f2c3;
    font-size: 6.5pt;
    font-weight: bold;
}

QLabel#label_chassis_footer {
    color: #5d627c;
    font-size: 6pt;
    font-weight: bold;
}

/* Marcos de Lectores de Linea, Obstaculos e IMU */
QFrame#frame_line_readings, QFrame#frame_obstacle_readings, QFrame#frame_imu_readings {
    background-color: #101018;
    border: 1px solid #202232;
    border-radius: 6px;
}

QLabel#label_title_line_readings {
    color: #00f2c3;
    font-size: 7.5pt;
    font-weight: bold;
    letter-spacing: 0.5px;
}

QLabel#label_title_obstacle_readings {
    color: #e14eca;
    font-size: 7.5pt;
    font-weight: bold;
    letter-spacing: 0.5px;
}

QLabel#label_title_imu_readings {
    color: #7982a9;
    font-size: 7pt;
    font-weight: bold;
    letter-spacing: 0.5px;
}

/* Estilos de las etiquetas individuales de los sensores de linea */
QLabel#ir2_label, QLabel#ir4_label, QLabel#ir6_label {
    color: #00f2c3;
    font-size: 7pt;
    font-weight: bold;
    padding-left: 2px;
}

/* Estilos de las etiquetas individuales de los sensores de obstaculos */
QLabel#ir7_label, QLabel#ir5_label, QLabel#ir8_label, QLabel#ir3_label, QLabel#ir1_label {
    color: #e14eca;
    font-size: 7pt;
    font-weight: bold;
    padding-left: 2px;
}

/* LCDs de sensores de linea (Piso) */
QLCDNumber#ir2_data, QLCDNumber#ir4_data, QLCDNumber#ir6_data {
    color: #00f2c3;
    background-color: #121a22;
    border: 1px solid #1e3a38;
    border-radius: 4px;
    min-height: 22px;
}

/* LCDs de Distancia Calculada en cm (Obstaculos) */
QLCDNumber#ir1_cm_data, QLCDNumber#ir3_cm_data, QLCDNumber#ir5_cm_data,
QLCDNumber#ir7_cm_data, QLCDNumber#ir8_cm_data {
    color: #00f2c3;
    background-color: #0b1118;
    border: 1px solid #00f2c3;
    border-radius: 3px;
    min-height: 20px;
    max-height: 22px;
    min-width: 50px;
}

/* LCDs de valor crudo ADC (Obstaculos) */
QLCDNumber#ir7_data, QLCDNumber#ir5_data, QLCDNumber#ir8_data, QLCDNumber#ir3_data, QLCDNumber#ir1_data {
    color: #ff79c6;
    background-color: #17111c;
    border: 1px solid #3d2036;
    border-radius: 3px;
    min-height: 18px;
    max-height: 20px;
    min-width: 46px;
}

/* Etiquetas de sensores de linea */
QLabel#ir2_label, QLabel#ir4_label, QLabel#ir6_label {
    color: #00f2c3;
    font-size: 8pt;
    font-weight: bold;
    padding-left: 2px;
}

/* Etiquetas de sensores de distancia */
QLabel#ir1_label, QLabel#ir3_label, QLabel#ir5_label, QLabel#ir7_label, QLabel#ir8_label {
    color: #ff79c6;
    font-size: 7.5pt;
    font-weight: bold;
    padding-left: 1px;
}

QLabel#ir1_dist_label, QLabel#ir3_dist_label, QLabel#ir5_dist_label, QLabel#ir7_dist_label, QLabel#ir8_dist_label {
    color: #00f2c3;
    font-size: 7.5pt;
    font-weight: bold;
}

QLabel#ir1_cm_unit, QLabel#ir3_cm_unit, QLabel#ir5_cm_unit, QLabel#ir7_cm_unit, QLabel#ir8_cm_unit {
    color: #00f2c3;
    font-size: 8pt;
    font-weight: bold;
}


/* Barras de Distancia de Obstaculos */
QProgressBar#bar_ir1, QProgressBar#bar_ir3, QProgressBar#bar_ir5,
QProgressBar#bar_ir7, QProgressBar#bar_ir8 {
    border: 1px solid #1f2e29;
    border-radius: 3px;
    background-color: #0b1115;
    text-align: center;
    color: #ffffff;
    font-size: 6pt;
    font-weight: bold;
    min-height: 12px;
    max-height: 14px;
}

QProgressBar#bar_ir1::chunk, QProgressBar#bar_ir3::chunk, QProgressBar#bar_ir5::chunk,
QProgressBar#bar_ir7::chunk, QProgressBar#bar_ir8::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00e676, stop:1 #00f2c3);
    border-radius: 2px;
}

/* Barras de Lectores de Linea */
QProgressBar#bar_ir2, QProgressBar#bar_ir4, QProgressBar#bar_ir6 {
    border: 1px solid #162432;
    border-radius: 3px;
    background-color: #0c1219;
    text-align: center;
    color: #ffffff;
    font-size: 6pt;
    font-weight: bold;
    min-height: 10px;
    max-height: 12px;
}

QProgressBar#bar_ir2::chunk, QProgressBar#bar_ir4::chunk, QProgressBar#bar_ir6::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #00b4d8, stop:1 #00f2c3);
    border-radius: 2px;
}

QLabel#ir1_raw_tag, QLabel#ir3_raw_tag, QLabel#ir5_raw_tag, QLabel#ir7_raw_tag, QLabel#ir8_raw_tag {
    color: #72768f;
    font-size: 6.5pt;
}

/* Sensores MPU / ACC / Gyro (Menor Prioridad) */
QLabel#ax_label, QLabel#ay_label, QLabel#az_label,
QLabel#gx_label, QLabel#gy_label, QLabel#gz_label,
QLabel#angle_label, QLabel#turn_offset_label, QLabel#angle_hr_label, QLabel#dt_ms_label {
    color: #6f748b;
    font-size: 7.5pt;
    font-weight: normal;
    padding-left: 1px;
}

QLCDNumber#ax_data, QLCDNumber#ay_data, QLCDNumber#az_data,
QLCDNumber#gx_data, QLCDNumber#gy_data, QLCDNumber#gz_data,
QLCDNumber#angle_data, QLCDNumber#turn_offset_data, QLCDNumber#angle_hr_data, QLCDNumber#dt_ms_data {
    color: #4a7570;
    background-color: #12131d;
    border: 1px solid #1c1e2b;
    border-radius: 3px;
    min-height: 18px;
}




/* Barra de Navegacion Superior (Header) */
QFrame#header_navigation_bar {
    background-color: #13141f;
    border: 1px solid #25283b;
    border-radius: 8px;
    padding: 0px;
}

/* Botones de Pestanas de Navegacion */
QPushButton#btn_nav_infrarrojos, QPushButton#btn_nav_visualizacion,
QPushButton#btn_nav_tuning, QPushButton#btn_nav_goto {
    background-color: #27293d;
    color: #00f2c3;
    border: 1px solid #e14eca;
    border-radius: 6px;
    padding: 0px 14px;
    font-size: 8.5pt;
    font-weight: bold;
    min-height: 30px;
    max-height: 30px;
}

QPushButton#btn_nav_infrarrojos:hover, QPushButton#btn_nav_visualizacion:hover,
QPushButton#btn_nav_tuning:hover, QPushButton#btn_nav_goto:hover {
    background-color: #3d2047;
    color: #00f2c3;
    border: 1.5px solid #e14eca;
}

QPushButton#btn_nav_infrarrojos:checked, QPushButton#btn_nav_visualizacion:checked,
QPushButton#btn_nav_tuning:checked, QPushButton#btn_nav_goto:checked {
    background-color: #4a154b;
    color: #00f2c3;
    border: 2px solid #e14eca;
}

QPushButton#btn_nav_infrarrojos:checked:hover, QPushButton#btn_nav_visualizacion:checked:hover,
QPushButton#btn_nav_tuning:checked:hover, QPushButton#btn_nav_goto:checked:hover {
    background-color: #551956;
    color: #00f2c3;
    border: 2px solid #e14eca;
}

  /* Botones de Modo del Robot (Derecha) */

  QPushButton#btn_mode_balance {
      background-color: #12202c;
      color: #00bcd4;
      border: 1px solid #00bcd4;
      border-radius: 6px;
      padding: 0px 12px;
      font-size: 8.5pt;
      font-weight: bold;
      min-height: 30px;
      max-height: 30px;
  }
  QPushButton#btn_mode_balance:hover {
      background-color: #183344;
      color: #00bcd4;
      border: 1.5px solid #00bcd4;
  }
  QPushButton#btn_mode_balance:checked {
      background-color: #0f384a;
      color: #00bcd4;
      border: 2px solid #00bcd4;
  }
  QPushButton#btn_mode_balance:checked:hover {
      background-color: #13465c;
      color: #00bcd4;
      border: 2px solid #00bcd4;
  }
  
  QPushButton#btn_mode_line {
      background-color: #0c2617;
      color: #00e676;
      border: 1px solid #00e676;
      border-radius: 6px;
      padding: 0px 12px;
      font-size: 8.5pt;
      font-weight: bold;
      min-height: 30px;
      max-height: 30px;
  }
  QPushButton#btn_mode_line:hover {
      background-color: #123822;
      color: #00e676;
      border: 1.5px solid #00e676;
  }
  QPushButton#btn_mode_line:checked {
      background-color: #0d381e;
      color: #00e676;
      border: 2px solid #00e676;
  }
  QPushButton#btn_mode_line:checked:hover {
      background-color: #114726;
      color: #00e676;
      border: 2px solid #00e676;
  }

  QPushButton#btn_mode_dodge {
      background-color: #261b0c;
      color: #ff9100;
      border: 1px solid #ff9100;
      border-radius: 6px;
      padding: 0px 12px;
      font-size: 8.5pt;
      font-weight: bold;
      min-height: 30px;
      max-height: 30px;
  }
  QPushButton#btn_mode_dodge:hover {
      background-color: #3b2a14;
      color: #ff9100;
      border: 1.5px solid #ff9100;
  }
  QPushButton#btn_mode_dodge:checked {
      background-color: #42280a;
      color: #ff9100;
      border: 2px solid #ff9100;
  }
  QPushButton#btn_mode_dodge:checked:hover {
      background-color: #4f310d;
      color: #ff9100;
      border: 2px solid #ff9100;
  }

  QPushButton#btn_mode_goto {
      background-color: #2a1217;
      color: #ff5252;
      border: 1px solid #ff5252;
      border-radius: 6px;
      padding: 0px 12px;
      font-size: 8.5pt;
      font-weight: bold;
      min-height: 30px;
      max-height: 30px;
  }
  QPushButton#btn_mode_goto:hover {
      background-color: #38191f;
      color: #ff5252;
      border: 1.5px solid #ff5252;
  }
  QPushButton#btn_mode_goto:checked {
      background-color: #4d1a24;
      color: #ff5252;
      border: 2px solid #ff5252;
  }
  QPushButton#btn_mode_goto:checked:hover {
      background-color: #5c1f2b;
      color: #ff5252;
      border: 2px solid #ff5252;
  }

  /* Boton de STOP Rojo-Magenta al lado de la Brujula */
  QPushButton#btn_car_stop {
      background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ff2a6d, stop:0.45 #c2185b, stop:1 #7a083a);
      color: #ffffff;
      border: 1.5px solid #fd5d93;
      border-radius: 8px;
      font-size: 22pt;
      font-weight: 900;
      letter-spacing: 3px;
      padding: 6px 10px;
      min-width: 80px;
  }
  QPushButton#btn_car_stop:hover {
      background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ff4d84, stop:0.45 #d81b60, stop:1 #9c0b4c);
      border: 2px solid #ff79b0;
      color: #ffffff;
  }
  QPushButton#btn_car_stop:pressed {
      background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #6b0733, stop:1 #3d021c);
      border: 1.5px solid #e14eca;
      color: #ffc2d4;
  }




  /* Teclas de Control Modo GoTo estilo teclado */
  QPushButton#btn_goto_up, QPushButton#btn_goto_down,
  QPushButton#btn_goto_left, QPushButton#btn_goto_right, QPushButton#btn_goto_center {
      background-color: #151828;
      color: #e2e8f0;
      border: 2px solid #2e3856;
      border-radius: 10px;
      font-size: 11pt;
      font-weight: bold;
  }
  QPushButton#btn_goto_up:hover, QPushButton#btn_goto_down:hover,
  QPushButton#btn_goto_left:hover, QPushButton#btn_goto_right:hover, QPushButton#btn_goto_center:hover {
      background-color: #1e2238;
      border-color: #00e676;
      color: #ffffff;
  }
  QPushButton#btn_goto_up:pressed, QPushButton#btn_goto_down:pressed,
  QPushButton#btn_goto_left:pressed, QPushButton#btn_goto_right:pressed, QPushButton#btn_goto_center:pressed {
      background-color: #00e676;
      color: #081a10;
      border-color: #ffffff;
  }

  QPushButton#pushButton_blockAutoData, QPushButton#pushButton_blockAutoData_comm {
      background-color: #151522;
      color: #00f2c3;
      border-top: 1px solid #2d2f44;
      border-left: 1px solid #2d2f44;
      border-bottom: 1px solid #0e0e16;
      border-right: 1px solid #0e0e16;
      border-radius: 8px;
      padding: 6px 12px;
      font-weight: bold;
      font-size: 8.5pt;
  }
  QPushButton#pushButton_blockAutoData:hover, QPushButton#pushButton_blockAutoData_comm:hover {
      background-color: #1d1e2e;
      color: #ffffff;
      border-top: 1px solid #3d4260;
      border-left: 1px solid #3d4260;
      border-bottom: 1px solid #14141e;
      border-right: 1px solid #14141e;
  }
  QPushButton#pushButton_blockAutoData:checked, QPushButton#pushButton_blockAutoData_comm:checked {
      background-color: #25121c;
      color: #ff4d6d;
      border-top: 1px solid #4a1f2b;
      border-left: 1px solid #4a1f2b;
      border-bottom: 1px solid #14080d;
      border-right: 1px solid #14080d;
      border-radius: 8px;
  }
  QPushButton#pushButton_blockAutoData:checked:hover, QPushButton#pushButton_blockAutoData_comm:checked:hover {
      background-color: #301724;
      color: #ff4d6d;
      border-top: 1px solid #5a2635;
      border-left: 1px solid #5a2635;
  }

  QPushButton#pushButton_sendCommand {
      background-color: #1a2736;
      color: #00f2c3;
      border: 1.5px solid #00f2c3;
      border-radius: 6px;
      padding: 6px;
      font-weight: bold;
      font-size: 9.5pt;
  }
  QPushButton#pushButton_sendCommand:hover {
      background-color: #00f2c3;
      color: #0c1520;
  }

QTabWidget::pane {
    border: 1px solid #27293d;
    background-color: #151522;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: #1e1e2d;
    color: #e2e2e2;
    border: 1px solid #27293d;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 6px 16px;
    font-weight: bold;
}

QTabBar::tab:selected {
    background-color: #27293d;
    color: #00f2c3;
    border-color: #e14eca;
}

QTabBar::tab:hover {
    background-color: #25273c;
    color: white;
}

QChartView, QChartView#PIDchart {
    background-color: #151522;
    border: 1px solid #27293d;
    border-radius: 8px;
}

QFrame#box_serial_conn, QFrame#box_udp_conn {
    background-color: #151522;
    border-top: 1px solid #2d2f44;
    border-left: 1px solid #2d2f44;
    border-bottom: 1px solid #0e0e16;
    border-right: 1px solid #0e0e16;
    border-radius: 8px;
}

QPushButton#pushButton_protocol_wifi:checked {
    background-color: #3d2047;
    color: #00f2c3;
    border: 1.5px solid #00f2c3;
}

QMenuBar {
    background-color: #1e1e2d;
    color: #e2e2e2;
    font-weight: bold;
}
QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    font-weight: bold;
}
QMenuBar::item:selected {
    background-color: #27293d;
    color: #00f2c3;
    border-radius: 4px;
}
QMenu {
    background-color: #1e1e2d;
    color: #e2e2e2;
    border: 1px solid #27293d;
    font-weight: bold;
}
QMenu::item:selected {
    background-color: #27293d;
    color: #00f2c3;
}
</string>
