QSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 28px; background: #267c8d; border: 1px solid #70bfd0; border-bottom-right-radius: 4px; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background: #36a1b6; }
