       <layout class="QVBoxLayout" name="layout_mainPlan" stretch="0,1,0">
        <item><layout class="QHBoxLayout" name="layout_routeControls">
         <item><widget class="QPushButton" name="pushButton_runRoute"><property name="text"><string>Ejecutar ruta</string></property></widget></item>
         <item><widget class="QPushButton" name="pushButton_reverseRoute"><property name="text"><string>Ruta inversa</string></property><property name="toolTip"><string>Desde el extremo final, recorre los setpoints en orden inverso hasta el origen. Conserva la ruta dibujada.</string></property></widget></item>
         <item><widget class="QPushButton" name="pushButton_routeOrientation"><property name="text"><string>Orientación</string></property><property name="checkable"><bool>true</bool></property><property name="toolTip"><string>Activa los ángulos de llegada manteniendo el recorrido recto. Arrastrá las flechas para orientar o hacé doble clic en un setpoint para editar X, Y y ángulo. Margen de llegada: hasta 1 cm y 3°.</string></property></widget></item>
         <item><widget class="QPushButton" name="pushButton_resumeRoute"><property name="text"><string>Continuar ruta</string></property><property name="toolTip"><string>Retoma la ruta detenida por Parada desde la última posición estimada confirmada por el robot.</string></property></widget></item>
         <item><widget class="QPushButton" name="pushButton_routeArc"><property name="text"><string>Arco</string></property><property name="checkable"><bool>true</bool></property><property name="toolTip"><string>Los nuevos setpoints crean arcos de 180°. Clic en un setpoint para editar X, Y, orientación, ángulo y sentido del arco. Desactivar vuelve a crear rectas.</string></property></widget></item>
         <item><widget class="QPushButton" name="pushButton_clearRoute"><property name="text"><string>Borrar puntos</string></property></widget></item>
         <item><widget class="QPushButton" name="pushButton_resetMap"><property name="text"><string>Reset</string></property><property name="toolTip"><string>Vuelve la posición y el recorrido mostrado a cero, sin borrar la ruta. No mueve físicamente el robot.</string></property></widget></item>
         <item><widget class="QPushButton" name="pushButton_importRoute"><property name="text"><string>Importar</string></property><property name="toolTip"><string>Reemplaza la ruta por los puntos de un archivo JSON válido.</string></property></widget></item>
         <item><widget class="QPushButton" name="pushButton_exportRoute"><property name="text"><string>Exportar</string></property><property name="toolTip"><string>Guarda los puntos de la ruta y la orientación del plano en un archivo JSON.</string></property></widget></item>
        </layout></item>
